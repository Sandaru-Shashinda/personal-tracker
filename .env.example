# Copy to .env.local and fill in. On Vercel, add the same keys under Project → Settings → Environment Variables.

# Neon Postgres connection string (use the *pooled* URL from the Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Web push (reminders). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Protects /api/cron/reminders. Any long random string.
CRON_SECRET=""
